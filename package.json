{
  "name": "cv",
  "type": "module",
  "version": "2.2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "font:download": "node scripts/download-fonts.mjs",
    "predev": "npm run font:download",
    "dev": "astro dev",
    "prestart": "npm run font:download",
    "start": "astro dev",
    "prebuild": "npm run font:download",
    "build": "astro check && astro build && npm run artifacts:generate",
    "artifacts:generate": "node scripts/generate-artifacts.mjs",
    "pdf:generate": "node scripts/generate-artifacts.mjs --pdf-only",
    "pdf:generate:pagination-test": "node scripts/generate-artifacts.mjs --pdf-only --pagination-test",
    "pretest": "npm run pdf:generate:pagination-test",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}

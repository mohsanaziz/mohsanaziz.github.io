---
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import Info from '@/components/Info.astro';
import Link from '@/components/Link.astro';
import RepositoryHeader from '@/components/RepositoryHeader.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import Skill from '@/components/Skill.astro';
import { cv } from '@/data/cv';
import Content from '@/layouts/Content.astro';
import Layout from '@/layouts/Layout.astro';

const githubProfile = cv.profile.socialLinks.find(({ icon }) => icon === 'github');
const location = cv.profile.contactDetails.find(({ icon }) => icon === 'location');

if (!githubProfile || !location) {
  throw new Error('The repository header and README require the GitHub profile and location from the CV data.');
}
---

<Layout title={cv.pageTitle} description={`${cv.profile.name} — ${cv.profile.jobTitle}`}>
  <RepositoryHeader image={cv.profile.image} owner="mohsanaziz" repository="cv" ownerHref={githubProfile.href} />

  <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid min-w-0 grid-cols-1 gap-6 min-[1000px]:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0 space-y-6">
        <SectionFrame title="README.md" icon="book">
          <article class="[overflow-wrap:anywhere]">
            <h1 class="text-3xl font-bold tracking-tight text-copy sm:text-4xl">{cv.profile.name}</h1>
            <p class="mt-2 text-base text-copy-muted">
              {cv.profile.jobTitle}<span aria-hidden="true"> · </span>{location.info}
            </p>

            <div class="mt-6 border-t border-rule pt-6">
              <h2 class="text-xl font-semibold text-copy">{cv.about.title}</h2>
              <div class="mt-4 flex flex-col gap-4 leading-7 text-copy-muted">
                {cv.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>
        </SectionFrame>

        <!-- These legacy regions remain publishable until their dedicated migration tickets. -->
        <div class="rounded-2xl border border-transparent bg-surface-overlay p-5 text-foreground">
          <Content title={cv.professionalExperience.title}>
            {
              cv.professionalExperience.entries.map((experience) => (
                <Card title={experience.title} subtitle={experience.subtitle} date={experience.date} />
              ))
            }
          </Content>

          <Content title={cv.clientProjects.title}>
            {
              cv.clientProjects.entries.map((project) => (
                <Card title={project.title} subtitle={project.subtitle} date={project.date}>
                  <Skill skills={{ values: project.technologies }} />
                  <div class="text-justify text-muted">
                    {project.description.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </Card>
              ))
            }
          </Content>
        </div>
      </div>

      <!-- The current contact regions move below the main column before their later redesign. -->
      <aside class="min-w-0 self-start rounded-2xl bg-surface-overlay p-5 text-foreground">
        <div class="flex flex-col gap-y-1.5">
          {
            cv.profile.contactDetails.map((contactDetail, index) => (
              <>
                <Info title={contactDetail.title} info={contactDetail.info}>
                  <Icon name={contactDetail.icon} class="h-5 w-5" />
                </Info>
                {index < cv.profile.contactDetails.length - 1 && <div class="border-t border-divider" />}
              </>
            ))
          }
        </div>

        <div class="mt-5 flex flex-wrap gap-3">
          {
            cv.profile.socialLinks.map((socialLink) => (
              <Link href={socialLink.href} label={socialLink.label}>
                <Icon name={socialLink.icon} class="h-5 w-5" />
              </Link>
            ))
          }
        </div>

        <div class="mt-5">
          <Link href={cv.profile.resume.href} label={cv.profile.resume.label}>
            <Icon name={cv.profile.resume.icon} class="me-1 h-6 w-6" />
            {cv.profile.resume.text}
          </Link>
        </div>
      </aside>
    </div>
  </main>
</Layout>

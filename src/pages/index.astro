---
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import Info from '@/components/Info.astro';
import Link from '@/components/Link.astro';
import Skill from '@/components/Skill.astro';
import { cv } from '@/data/cv';
import Content from '@/layouts/Content.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title={cv.pageTitle}>
  <main class="flex w-screen flex-col items-center px-5 pt-5 font-sans leading-relaxed md:px-0 lg:max-w-7xl">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      <aside class="top-5 flex flex-col items-center justify-center pt-16 md:sticky md:col-span-1 md:h-screen md:pl-5">
        <img
          src={cv.profile.image.src}
          alt={cv.profile.image.alt}
          class="z-10 h-56 w-auto rounded-3xl bg-accent p-1"
          loading="lazy"
          width={cv.profile.image.width}
          height={cv.profile.image.height}
          decoding="async"
        />

        <div class="relative mt-[-6rem] w-full max-w-[400px] rounded-2xl bg-surface-overlay p-5">
          <div class="flex flex-col gap-y-1.5">
            <div class="flex flex-col items-center gap-y-4 pt-24 pb-10">
              <h1 class="text-3xl font-bold">{cv.profile.name}</h1>
              <h2 class="text-center text-xl">{cv.profile.jobTitle}</h2>

              <div class="flex flex-row gap-x-4 pt-1 pb-3">
                {
                  cv.profile.socialLinks.map((socialLink) => (
                    <Link href={socialLink.href} label={socialLink.label}>
                      <Icon name={socialLink.icon} />
                    </Link>
                  ))
                }
              </div>

              <div class="relative flex w-full flex-col gap-x-7 gap-y-1 rounded-2xl bg-surface-raised p-5">
                <div class="flex flex-col gap-y-1.5">
                  {
                    cv.profile.contactDetails.map((contactDetail, index) => (
                      <>
                        <Info title={contactDetail.title} info={contactDetail.info}>
                          <Icon name={contactDetail.icon} />
                        </Info>
                        {index < cv.profile.contactDetails.length - 1 && <div class="border-t border-divider" />}
                      </>
                    ))
                  }
                </div>
              </div>
            </div>

            <Link href={cv.profile.resume.href} label={cv.profile.resume.label}>
              <Icon name={cv.profile.resume.icon} />
              {cv.profile.resume.text}
            </Link>
          </div>
        </div>
      </aside>

      <div class="md:col-span-2 md:mr-5">
        <div class="mt-5 rounded-2xl border border-transparent bg-surface-overlay p-5">
          <Content title={cv.about.title}>
            <p class="text-muted">
              {
                cv.about.paragraphs.map((paragraph, index) => (
                  <>
                    {paragraph}
                    {index < cv.about.paragraphs.length - 1 && (
                      <>
                        <br />
                        <br />
                      </>
                    )}
                  </>
                ))
              }
            </p>
          </Content>

          <Content title={cv.professionalExperience.title}>
            {
              cv.professionalExperience.entries.map((experience) => (
                <Card title={experience.title} subtitle={experience.subtitle} date={experience.date} />
              ))
            }
          </Content>

          <Content title={cv.clientProjects.title}>
            {
              cv.clientProjects.entries.map((project) => (
                <Card title={project.title} subtitle={project.subtitle} date={project.date}>
                  <Skill skills={{ title: '', values: project.technologies }} />
                  <p class="text-justify text-muted">
                    {project.description.map((paragraph, index) => (
                      <>
                        {paragraph}
                        {index < project.description.length - 1 && <br />}
                      </>
                    ))}
                  </p>
                </Card>
              ))
            }
          </Content>
        </div>
      </div>
    </div>
  </main>
</Layout>

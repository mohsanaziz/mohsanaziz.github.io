---
import ContactDetails from '@/components/ContactDetails.astro';
import Contributors from '@/components/Contributors.astro';
import EmployerCard from '@/components/EmployerCard.astro';
import LanguageBar from '@/components/LanguageBar.astro';
import MissionRelease from '@/components/MissionRelease.astro';
import ReleaseAsset from '@/components/ReleaseAsset.astro';
import RepositoryHeader from '@/components/RepositoryHeader.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import { countMissionsByEmployer, formatPeriodDuration, getCareerDurationInYears, mapMissionsToEmployers } from '@/data/career';
import { cv } from '@/data/cv';
import { deriveLanguageShares } from '@/data/languages';
import { deriveMissionReleases } from '@/data/missions';
import Layout from '@/layouts/Layout.astro';
import packageMetadata from '@package';

const githubProfile = cv.profile.socialLinks.find(({ href }) => new URL(href).hostname === 'github.com');
const linkedinProfile = cv.profile.socialLinks.find(({ href }) => new URL(href).hostname.endsWith('linkedin.com'));
const profileLocation = cv.profile.contactDetails.find(({ title }) => title === 'Location');

function urlPathSegments(href: string): string[] {
  return new URL(href, Astro.site ?? Astro.url).pathname.split('/').filter(Boolean);
}

if (!githubProfile || !linkedinProfile || !profileLocation) {
  throw new Error('The page requires the GitHub profile, LinkedIn profile and location from the CV data.');
}

const githubOwner = urlPathSegments(githubProfile.href).at(0);
const linkedinPath = urlPathSegments(linkedinProfile.href).join('/');
const resumeFileName = urlPathSegments(cv.profile.resume.href).at(-1);

if (!githubOwner || !linkedinPath || !resumeFileName) {
  throw new Error('The profile and resume URLs must contain displayable paths.');
}

const languages = deriveLanguageShares(cv.clientProjects.entries);
const currentDate = new Date();
const careerDurationInYears = getCareerDurationInYears(cv.professionalExperience.entries, currentDate);
const employerCount: number = cv.professionalExperience.entries.length;
const employersByMission = mapMissionsToEmployers(cv.professionalExperience.entries, cv.clientProjects.entries, currentDate);
const missionCountsByEmployer = countMissionsByEmployer(cv.professionalExperience.entries, employersByMission);
const employersWithMissionCounts = cv.professionalExperience.entries.map((experience) => {
  const missionCount = missionCountsByEmployer.get(experience);

  if (missionCount === undefined) {
    throw new Error(`The mission count is missing for ${experience.title}.`);
  }

  return { experience, missionCount };
});
const employerLabel = `${employerCount} ${employerCount === 1 ? 'employeur' : 'employeurs'}`;
const careerDurationLabel = `${careerDurationInYears} ${careerDurationInYears === 1 ? 'an' : 'ans'}`;
const missionCount: number = cv.clientProjects.entries.length;
const missionVersionLabel = `${missionCount} ${missionCount === 1 ? 'version' : 'versions'}`;
const missionReleases = deriveMissionReleases(cv.clientProjects.entries, employersByMission, currentDate);
---

<Layout title={cv.pageTitle} description={`${cv.profile.name} — ${cv.profile.jobTitle}`}>
  <RepositoryHeader image={cv.profile.image} owner={githubOwner} repository="cv" ownerHref={githubProfile.href} />

  <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid min-w-0 grid-cols-1 gap-6 min-[1000px]:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0 space-y-6">
        <SectionFrame title="README.md" icon="book">
          <article class="[overflow-wrap:anywhere]">
            <h1 class="text-3xl font-bold tracking-tight text-copy sm:text-4xl">{cv.profile.name}</h1>
            <p class="mt-2 text-base text-copy-muted">
              {cv.profile.jobTitle}<span class="sr-only">, </span><span aria-hidden="true"> · </span>{profileLocation.info}
            </p>

            <div class="mt-6 border-t border-rule pt-6">
              <h2 class="text-xl font-semibold text-copy">{cv.about.title}</h2>
              <div class="mt-4 flex flex-col gap-4 leading-7 text-copy-muted">
                {cv.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>
        </SectionFrame>

        <SectionFrame title={cv.professionalExperience.title} counter={`${employerLabel} · ${careerDurationLabel}`}>
          <div class="grid grid-cols-1 gap-4 min-[700px]:grid-cols-2">
            {
              employersWithMissionCounts.map(({ experience, missionCount }) => (
                <EmployerCard
                  company={experience.title}
                  role={experience.subtitle}
                  contract={experience.contract}
                  period={experience.date}
                  duration={formatPeriodDuration(experience.date, currentDate)}
                  missionCount={missionCount}
                />
              ))
            }
          </div>
        </SectionFrame>

        <SectionFrame title={cv.clientProjects.title} counter={missionVersionLabel}>
          <div class="divide-y divide-rule">
            {
              missionReleases.map(({ mission, summary, showStatusBadge }) => (
                <MissionRelease
                  title={mission.title}
                  summary={summary}
                  description={mission.description}
                  showStatusBadge={showStatusBadge}
                />
              ))
            }
          </div>
        </SectionFrame>
      </div>

      <aside class="min-w-0 space-y-6 self-start" aria-label="Informations complémentaires">
        <SectionFrame title="Contact">
          <ContactDetails details={cv.profile.contactDetails} />
        </SectionFrame>

        <SectionFrame title="Contributeurs">
          <Contributors
            image={cv.profile.image.src}
            github={{ href: githubProfile.href, label: githubOwner }}
            linkedin={{ href: linkedinProfile.href, label: linkedinPath }}
          />
        </SectionFrame>

        <SectionFrame title="Releases" icon="tag">
          <ReleaseAsset version={`v${packageMetadata.version}`} href={cv.profile.resume.href} fileName={resumeFileName} />
        </SectionFrame>

        <SectionFrame title="Langages">
          <LanguageBar languages={languages} />
        </SectionFrame>
      </aside>
    </div>
  </main>
</Layout>

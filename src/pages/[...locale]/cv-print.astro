---
import { GITHUB_LEXICON } from '@/components/lexicon';
import { STATUS_CLASSES_BY_TONE, TONE_BY_CONTRACT } from '@/components/status';
import { derivedCv } from '@/data/derived';
import { resolveProfileDetails, urlPathSegments } from '@/data/profile';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations } from '@/i18n/translate';
import { buildMissionReleaseViews, cvView } from '@/i18n/views';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = localeStaticPaths;

const translate = useTranslations(Astro.currentLocale);
const { print } = translate.messages;
const cv = cvView(translate.locale);
const printLineHeight = {
  fr: 1.3,
  en: 1.3,
  // Match the measured natural line box of Noto Sans Arabic v2.012 used by the web view.
  ar: 2.112,
}[translate.locale];

const { profileLocation } = resolveProfileDetails(cv.profile);

const missionReleases = buildMissionReleaseViews(translate, cv, derivedCv.missionReleases);
const experienceGroups = cv.professionalExperience.entries.map((employer, index) => ({
  employer,
  headingId: `employer-${index}`,
  releases: missionReleases.filter((release) => release.employerId === employer.id),
}));
const contactDetails = cv.profile.contactDetails.filter(({ id }) => id !== 'location');
const socialProfiles = cv.profile.socialLinks.map((link) => ({
  label: link.label,
  value: urlPathSegments(link.href).join('/'),
  href: link.href,
}));
---

<Layout title={cv.metadata.printablePageTitle} description={cv.metadata.pageDescription} robots="noindex, nofollow">
  <main class="print-document" style={`--print-line-height: ${printLineHeight}`}>
    <section class="print-frame" aria-label={GITHUB_LEXICON.readme}>
      <header class="frame-header">
        <span class="frame-title">{GITHUB_LEXICON.readme}</span>
      </header>

      <div class="readme-content">
        <h1>
          {
            cv.profile.alternateName ? (
              <>
                <span>{cv.profile.name}</span>
                <span class="alternate-name">{cv.profile.alternateName}</span>
              </>
            ) : (
              cv.profile.name
            )
          }
        </h1>
        <p class="profile-summary">{cv.profile.jobTitle} <span aria-hidden="true">·</span> {profileLocation.info}</p>

        <ul class="contact-line" aria-label={print.contactDetails}>
          {
            contactDetails.map((detail) => (
              <li>
                <strong>{translate.fieldLabel(detail.title)}</strong> {detail.info}
              </li>
            ))
          }
          {
            socialProfiles.map((profile) => (
              <li>
                <strong>{translate.fieldLabel(profile.label)}</strong> <a href={profile.href}>{profile.value}</a>
              </li>
            ))
          }
        </ul>

        <div class="about">
          <h2>{cv.about.title}</h2>
          {cv.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="print-frame experience-frame" aria-labelledby="experience-title">
      <header class="frame-header">
        <h2 id="experience-title">{print.experienceAndClientProjects}</h2>
      </header>

      <div class="experience-content">
        {
          experienceGroups.map(({ employer, headingId, releases }) => (
            <section class="employer-group" aria-labelledby={headingId}>
              <header class="employer-banner">
                <div class="employer-heading">
                  <h3 id={headingId}>{employer.name}</h3>
                  <span class:list={['badge', STATUS_CLASSES_BY_TONE[TONE_BY_CONTRACT[employer.contract]]]}>
                    {translate.contract(employer.contract)}
                  </span>
                </div>
                <p>{employer.jobTitle}</p>
                <p>{translate.period(employer.period)}</p>
              </header>

              <div class="missions">
                {releases.map(({ mission, summary, showStatusBadge }) => (
                  <article class="mission-release">
                    <header class="mission-header">
                      <code>{summary.version}</code>
                      <h4>{mission.name}</h4>
                      {showStatusBadge && (
                        <span class="badge border-status-success/45 bg-status-success/14 text-status-success">{GITHUB_LEXICON.latest}</span>
                      )}
                      <p class="mission-period">{summary.period}</p>
                    </header>

                    <p class="mission-client">
                      <strong>{translate.fieldLabel(print.client)}</strong> {summary.client}
                    </p>
                    <div class="mission-description">
                      {mission.description.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                    <p class="mission-environment">
                      <strong>{translate.fieldLabel(print.environment)}</strong> {summary.technologies.join(', ')}
                    </p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  @font-face {
    font-family: 'Noto Sans Arabic Print';
    src: url('/fonts/NotoSansArabic-arabic.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: block;
    unicode-range: U+0600-06FF;
  }

  .print-document {
    --print-type-scale: 1;
    --print-line-height: 1.3;

    color-scheme: only light;
    box-sizing: border-box;
    width: min(210mm, 100%);
    min-height: 297mm;
    margin: 0 auto;
    padding: 8mm;
    background: var(--color-page);
    color: var(--color-copy);
    font-size: calc(8px * var(--print-type-scale));
    line-height: var(--print-line-height);
  }

  .print-document *,
  .print-document *::before,
  .print-document *::after {
    box-sizing: border-box;
  }

  .print-document :where(h1, h2, h3, h4, p, ul) {
    margin: 0;
  }

  .print-document a {
    color: var(--color-link);
  }

  .print-frame {
    overflow: hidden;
    border: 1px solid var(--color-frame-border);
    border-radius: 6px;
    background: var(--color-page);
  }

  .print-frame + .print-frame {
    margin-top: 4mm;
  }

  .frame-header {
    padding: 1.3mm 2.5mm;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-panel);
  }

  .frame-header :where(h2, .frame-title) {
    font-size: 1em;
    font-weight: 650;
  }

  .readme-content {
    padding: 2.4mm;
  }

  .readme-content h1 {
    font-size: 2.125em;
    line-height: calc(var(--print-line-height) * 1.05);
    letter-spacing: -0.025em;
  }

  .alternate-name {
    display: block;
    margin-top: 0.25em;
    color: var(--color-copy-muted);
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: normal;
  }

  .profile-summary {
    margin-top: 1mm !important;
    color: var(--color-copy-muted);
    font-size: 1em;
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5mm 2.5mm;
    padding: 1.4mm 0 0;
    list-style: none;
  }

  .about {
    margin-top: 1.7mm;
    padding-top: 1.7mm;
    border-top: 1px solid var(--color-rule);
  }

  .about h2 {
    margin-bottom: 0.8mm !important;
    font-size: 1.125em;
    font-weight: 650;
  }

  .about p + p,
  .mission-description p + p {
    margin-top: 0.5mm;
  }

  .experience-content {
    padding: 2.4mm;
  }

  .employer-group + .employer-group {
    margin-top: 1.8mm;
  }

  .employer-banner {
    display: flex;
    align-items: center;
    gap: 1.1mm;
    padding: 1.1mm 1.6mm;
    border: 1px solid var(--color-frame-border);
    border-radius: 4px;
    background: var(--color-panel);
    break-inside: avoid;
    break-after: avoid;
    page-break-inside: avoid;
    page-break-after: avoid;
  }

  .employer-heading {
    display: flex;
    align-items: center;
    gap: 1.1mm;
  }

  .employer-heading h3 {
    font-size: 1em;
    font-weight: 700;
  }

  .employer-banner > p:first-of-type {
    color: var(--color-copy-muted);
  }

  .employer-banner > p:last-child {
    margin-inline-start: auto;
    white-space: nowrap;
    color: var(--color-copy-muted);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    flex: none;
    padding: 0.2mm 0.9mm;
    border-width: 1px;
    border-style: solid;
    border-radius: 999px;
    font-size: 0.8125em;
    font-weight: 650;
    line-height: calc(var(--print-line-height) * 1.2);
  }

  .mission-release {
    padding: 1.5mm 0.8mm;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .mission-release + .mission-release {
    border-top: 1px solid var(--color-rule);
  }

  .mission-header {
    display: flex;
    align-items: center;
    gap: 1.1mm;
  }

  .mission-header code {
    flex: none;
    padding: 0.3mm 1mm;
    border: 1px solid var(--color-frame-border);
    border-radius: 3px;
    background: var(--color-panel);
    font-size: 0.8125em;
    font-weight: 650;
  }

  .mission-header h4 {
    font-size: 1em;
    font-weight: 700;
  }

  .mission-period {
    margin-inline-start: auto !important;
    white-space: nowrap;
    color: var(--color-copy-muted);
  }

  .mission-client {
    margin-top: 0.5mm !important;
    color: var(--color-copy-muted);
  }

  .mission-description {
    margin-top: 0.5mm;
  }

  .mission-environment {
    margin-top: 0.6mm !important;
    color: var(--color-copy-muted);
  }

  @media (max-width: 600px) {
    .print-document {
      padding: 4mm;
    }

    .employer-banner,
    .mission-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .employer-banner > p:last-child,
    .mission-period {
      width: 100%;
      margin-inline-start: 0 !important;
    }
  }

  @media print {
    :global(html),
    :global(body) {
      color-scheme: only light;
      background: var(--color-page);
    }

    .print-document {
      width: auto;
      min-height: auto;
      margin: 0;
      padding: 0;
      /* The first face is Arabic-only, so Latin keeps the ADR 0006 system stack unchanged. */
      font-family: 'Noto Sans Arabic Print', Arial, 'Liberation Sans', sans-serif;
      font-variant-ligatures: none;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .mission-header code {
      /* Arabic digits use the hosted face; ASCII code tokens keep the ADR 0006 monospace stack. */
      font-family: 'Noto Sans Arabic Print', 'Courier New', 'Liberation Mono', monospace;
    }

    .print-frame {
      box-decoration-break: clone;
    }
  }

  @page {
    size: A4 portrait;
    margin: 8mm;
  }
</style>

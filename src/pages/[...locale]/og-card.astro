---
import Icon from '@/components/Icon.astro';
import { GITHUB_LEXICON } from '@/components/lexicon';
import { imageAsset } from '@/data/images';
import { resolveProfileDetails, urlPathSegments } from '@/data/profile';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations } from '@/i18n/translate';
import { cvView } from '@/i18n/views';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';

export const getStaticPaths = localeStaticPaths;

const translate = useTranslations(Astro.currentLocale);
const cv = cvView(translate.locale);
const portrait = imageAsset(cv.profile.image.source);
const { githubProfile } = resolveProfileDetails(cv.profile);
const githubOwner = urlPathSegments(githubProfile.href).at(0);
const siteLabel = Astro.site?.hostname;

if (!githubOwner || !siteLabel) {
  throw new Error('The Open Graph card requires a GitHub owner and the configured site hostname.');
}
---

<Layout title={cv.metadata.pageTitle} description={cv.metadata.pageDescription}>
  <main class="flex h-[630px] w-[1200px] flex-col overflow-hidden bg-page font-sans text-copy [color-scheme:light]">
    <header class="flex shrink-0 items-center gap-4 border-b-2 border-frame-border bg-panel px-14 py-6">
      <Icon name="book" class="h-8 w-8 shrink-0 text-copy-muted" />
      <p class="font-mono text-[34px] leading-none" data-og-card-mono>
        <span class="text-copy-muted">{githubOwner}</span>
        <span class="text-copy-muted"> / </span>
        <span class="font-bold">{GITHUB_LEXICON.repository}</span>
      </p>
      <span class="ms-auto rounded-full border-2 border-frame-border px-5 py-1.5 text-[24px] font-medium text-copy-muted">
        {GITHUB_LEXICON.visibility}
      </span>
    </header>

    <div class="flex min-h-0 flex-1 flex-col justify-center px-14">
      <p class="text-[124px] leading-[0.92] font-black tracking-tight [overflow-wrap:anywhere]" data-og-card-name>{cv.profile.name}</p>
      {cv.profile.alternateName && <p class="mt-3 text-[36px] leading-none font-medium text-copy-muted">{cv.profile.alternateName}</p>}
      <p class="mt-6 text-[42px] leading-tight text-copy-muted">{cv.profile.jobTitle}</p>
    </div>

    <footer class="flex shrink-0 items-center gap-5 border-t border-rule px-14 py-7">
      <Image
        src={portrait}
        alt=""
        class="h-[76px] w-[76px] shrink-0 rounded-full object-cover"
        loading="eager"
        width={76}
        height={76}
        densities={[1, 2]}
        decoding="async"
      />
      <span class="text-[28px] text-copy-muted">{cv.metadata.openGraphLocation}</span>
      <span class="ms-auto font-mono text-[26px] text-copy-muted" data-og-card-mono>{siteLabel}</span>
    </footer>
  </main>
</Layout>

---
import ContactDetails from '@/components/ContactDetails.astro';
import Contributors from '@/components/Contributors.astro';
import EmployerCard from '@/components/EmployerCard.astro';
import LanguageBar from '@/components/LanguageBar.astro';
import { GITHUB_LEXICON } from '@/components/lexicon';
import MissionRelease from '@/components/MissionRelease.astro';
import ReleaseAsset from '@/components/ReleaseAsset.astro';
import RepositoryHeader from '@/components/RepositoryHeader.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import { getPeriodDurationInMonths } from '@/data/career';
import { derivedCv } from '@/data/derived';
import { imageAsset } from '@/data/images';
import { resolveProfileDetails, urlPathSegments } from '@/data/profile';
import { localeStaticPaths, resumeFileName, resumePath } from '@/i18n/routing';
import { useTranslations } from '@/i18n/translate';
import { buildMissionReleaseViews, cvView } from '@/i18n/views';
import Layout from '@/layouts/Layout.astro';
import packageMetadata from '@package';

export const getStaticPaths = localeStaticPaths;

const translate = useTranslations(Astro.currentLocale);
const cv = cvView(translate.locale);
const portrait = { src: imageAsset(cv.profile.image.source), alt: cv.profile.image.alt };

const { githubProfile, linkedinProfile, profileLocation } = resolveProfileDetails(cv.profile);

const githubOwner = urlPathSegments(githubProfile.href).at(0);
const linkedinPath = urlPathSegments(linkedinProfile.href).join('/');

if (!githubOwner || !linkedinPath) {
  throw new Error('The profile URLs must contain displayable paths.');
}

const {
  buildDate: currentDate,
  careerDurationInYears,
  languages,
  missionCountsByEmployer,
  missionReleases: structuralMissionReleases,
} = derivedCv;
const employersWithMissionCounts = cv.professionalExperience.entries.map((employer) => {
  const missionCount = missionCountsByEmployer.get(employer.id);

  if (missionCount === undefined) {
    throw new Error(`The mission count is missing for ${employer.name}.`);
  }

  return { employer, durationInMonths: getPeriodDurationInMonths(employer.period, currentDate), missionCount };
});
const employerLabel = translate.count('employer', cv.professionalExperience.entries.length);
const careerDurationLabel = translate.count('year', careerDurationInYears);
const missionVersionLabel = translate.count('version', cv.clientProjects.entries.length);
const missionReleases = buildMissionReleaseViews(translate, cv, structuralMissionReleases);
---

<Layout title={cv.metadata.pageTitle} description={cv.metadata.pageDescription}>
  <RepositoryHeader image={portrait} owner={githubOwner} repository={GITHUB_LEXICON.repository} ownerHref={githubProfile.href} />

  <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid min-w-0 grid-cols-1 gap-6 min-[1000px]:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0 space-y-6">
        <SectionFrame title={GITHUB_LEXICON.readme} icon="book">
          <article class="[overflow-wrap:anywhere]">
            <h1 class="text-3xl font-bold tracking-tight text-copy sm:text-4xl">{cv.profile.name}</h1>
            <p class="mt-2 text-base text-copy-muted">
              {cv.profile.jobTitle}<span class="sr-only">, </span><span aria-hidden="true"> · </span>{profileLocation.info}
            </p>

            <div class="mt-6 border-t border-rule pt-6">
              <h2 class="text-xl font-semibold text-copy">{cv.about.title}</h2>
              <div class="mt-4 flex flex-col gap-4 leading-7 text-copy-muted">
                {cv.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>
        </SectionFrame>

        <SectionFrame title={cv.professionalExperience.title} counter={`${employerLabel} · ${careerDurationLabel}`}>
          <div class="grid grid-cols-1 gap-4 min-[700px]:grid-cols-2">
            {
              employersWithMissionCounts.map(({ employer, durationInMonths, missionCount }) => (
                <EmployerCard employer={employer} durationInMonths={durationInMonths} missionCount={missionCount} />
              ))
            }
          </div>
        </SectionFrame>

        <SectionFrame title={cv.clientProjects.title} counter={missionVersionLabel}>
          <div class="divide-y divide-rule">
            {
              missionReleases.map(({ mission, summary, showStatusBadge }) => (
                <MissionRelease
                  title={mission.name}
                  summary={summary}
                  description={mission.description}
                  showStatusBadge={showStatusBadge}
                />
              ))
            }
          </div>
        </SectionFrame>
      </div>

      <aside class="min-w-0 space-y-6 self-start" aria-label={translate.messages.navigation.additionalInformation}>
        <SectionFrame title={translate.messages.labels.contact}>
          <ContactDetails details={cv.profile.contactDetails} />
        </SectionFrame>

        <SectionFrame title={GITHUB_LEXICON.contributors}>
          <Contributors
            image={portrait.src}
            github={{ href: githubProfile.href, label: githubOwner }}
            linkedin={{ href: linkedinProfile.href, label: linkedinPath }}
          />
        </SectionFrame>

        <SectionFrame title={GITHUB_LEXICON.releases} icon="tag">
          <ReleaseAsset
            version={`v${packageMetadata.version}`}
            href={resumePath(translate.locale)}
            fileName={resumeFileName(translate.locale)}
          />
        </SectionFrame>

        <SectionFrame title={GITHUB_LEXICON.languages}>
          <LanguageBar languages={languages} />
        </SectionFrame>
      </aside>
    </div>
  </main>
</Layout>

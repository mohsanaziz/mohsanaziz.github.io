---
import { mapMissionsToEmployers } from '@/data/career';
import { cv } from '@/data/cv';
import { deriveMissionReleases } from '@/data/missions';
import { resolveProfileDetails, urlPathSegments } from '@/data/profile';
import Layout from '@/layouts/Layout.astro';

const currentDate = new Date();
const { githubProfile, linkedinProfile, profileLocation } = resolveProfileDetails(cv.profile);

const employersByMission = mapMissionsToEmployers(cv.professionalExperience.entries, cv.clientProjects.entries, currentDate);
const missionReleases = deriveMissionReleases(cv.clientProjects.entries, employersByMission, currentDate);
const experienceGroups = cv.professionalExperience.entries.map((employer, index) => ({
  employer,
  employerId: `employer-${index}`,
  releases: missionReleases.filter(({ mission }) => employersByMission.get(mission) === employer),
}));
const contactDetails = cv.profile.contactDetails.filter(({ title }) => title !== 'Location');
const socialProfiles = [
  { label: 'GitHub', value: urlPathSegments(githubProfile.href).join('/'), href: githubProfile.href },
  { label: 'LinkedIn', value: urlPathSegments(linkedinProfile.href).join('/'), href: linkedinProfile.href },
] as const;
---

<Layout title={`${cv.profile.name} — CV imprimable`} description={`${cv.profile.name} — ${cv.profile.jobTitle}`} robots="noindex, nofollow">
  <main class="print-document">
    <section class="print-frame" aria-label="README.md">
      <header class="frame-header">
        <span class="frame-title">README.md</span>
      </header>

      <div class="readme-content">
        <h1>{cv.profile.name}</h1>
        <p class="profile-summary">{cv.profile.jobTitle} <span aria-hidden="true">·</span> {profileLocation.info}</p>

        <ul class="contact-line" aria-label="Coordonnées">
          {
            contactDetails.map((detail) => (
              <li>
                <strong>{detail.title} :</strong> {detail.info}
              </li>
            ))
          }
          {
            socialProfiles.map((profile) => (
              <li>
                <strong>{profile.label} :</strong> <a href={profile.href}>{profile.value}</a>
              </li>
            ))
          }
        </ul>

        <div class="about">
          <h2>{cv.about.title}</h2>
          {cv.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="print-frame experience-frame" aria-labelledby="experience-title">
      <header class="frame-header">
        <h2 id="experience-title">Expérience &amp; projets client</h2>
      </header>

      <div class="experience-content">
        {
          experienceGroups.map(({ employer, employerId, releases }) => (
            <section class="employer-group" aria-labelledby={employerId}>
              <header class="employer-banner">
                <div class="employer-heading">
                  <h3 id={employerId}>{employer.title}</h3>
                  <span
                    class:list={[
                      'badge',
                      employer.contract === 'CDI'
                        ? 'border-status-cdi/45 bg-status-cdi/14 text-status-cdi'
                        : 'border-status-success/45 bg-status-success/14 text-status-success',
                    ]}
                  >
                    {employer.contract}
                  </span>
                </div>
                <p>{employer.subtitle}</p>
                <p>{employer.date}</p>
              </header>

              <div class="missions">
                {releases.map(({ mission, summary, showStatusBadge }) => (
                  <article class="mission-release">
                    <header class="mission-header">
                      <code>{summary.version}</code>
                      <h4>{mission.title}</h4>
                      {showStatusBadge && (
                        <span class="badge border-status-success/45 bg-status-success/14 text-status-success">Latest</span>
                      )}
                      <p class="mission-period">{summary.period}</p>
                    </header>

                    <p class="mission-client">
                      <strong>Client :</strong> {summary.client}
                    </p>
                    <div class="mission-description">
                      {mission.description.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                    <p class="mission-environment">
                      <strong>Environnement :</strong> {summary.technologies.join(', ')}
                    </p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .print-document {
    color-scheme: only light;
    box-sizing: border-box;
    width: min(210mm, 100%);
    min-height: 297mm;
    margin: 0 auto;
    padding: 8mm;
    background: var(--color-page);
    color: var(--color-copy);
    font-size: 8px;
    line-height: 1.3;
  }

  .print-document *,
  .print-document *::before,
  .print-document *::after {
    box-sizing: border-box;
  }

  .print-document :where(h1, h2, h3, h4, p, ul) {
    margin: 0;
  }

  .print-document a {
    color: var(--color-link);
  }

  .print-frame {
    overflow: hidden;
    border: 1px solid var(--color-frame-border);
    border-radius: 6px;
    background: var(--color-page);
  }

  .print-frame + .print-frame {
    margin-top: 4mm;
  }

  .frame-header {
    padding: 1.3mm 2.5mm;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-panel);
  }

  .frame-header :where(h2, .frame-title) {
    font-size: 8px;
    font-weight: 650;
  }

  .readme-content {
    padding: 2.4mm;
  }

  .readme-content h1 {
    font-size: 17px;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .profile-summary {
    margin-top: 1mm !important;
    color: var(--color-copy-muted);
    font-size: 8px;
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5mm 2.5mm;
    padding: 1.4mm 0 0;
    list-style: none;
  }

  .about {
    margin-top: 1.7mm;
    padding-top: 1.7mm;
    border-top: 1px solid var(--color-rule);
  }

  .about h2 {
    margin-bottom: 0.8mm !important;
    font-size: 9px;
    font-weight: 650;
  }

  .about p + p,
  .mission-description p + p {
    margin-top: 0.5mm;
  }

  .experience-content {
    padding: 2.4mm;
  }

  .employer-group + .employer-group {
    margin-top: 1.8mm;
  }

  .employer-banner {
    display: flex;
    align-items: center;
    gap: 1.1mm;
    padding: 1.1mm 1.6mm;
    border: 1px solid var(--color-frame-border);
    border-radius: 4px;
    background: var(--color-panel);
    break-after: avoid;
    page-break-after: avoid;
  }

  .employer-heading {
    display: flex;
    align-items: center;
    gap: 1.1mm;
  }

  .employer-heading h3 {
    font-size: 8px;
    font-weight: 700;
  }

  .employer-banner > p:first-of-type {
    color: var(--color-copy-muted);
  }

  .employer-banner > p:last-child {
    margin-left: auto;
    white-space: nowrap;
    color: var(--color-copy-muted);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    flex: none;
    padding: 0.2mm 0.9mm;
    border-width: 1px;
    border-style: solid;
    border-radius: 999px;
    font-size: 6.5px;
    font-weight: 650;
    line-height: 1.2;
  }

  .mission-release {
    padding: 1.5mm 0.8mm;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .mission-release + .mission-release {
    border-top: 1px solid var(--color-rule);
  }

  .mission-header {
    display: flex;
    align-items: center;
    gap: 1.1mm;
  }

  .mission-header code {
    flex: none;
    padding: 0.3mm 1mm;
    border: 1px solid var(--color-frame-border);
    border-radius: 3px;
    background: var(--color-panel);
    font-size: 6.5px;
    font-weight: 650;
  }

  .mission-header h4 {
    font-size: 8px;
    font-weight: 700;
  }

  .mission-period {
    margin-left: auto !important;
    white-space: nowrap;
    color: var(--color-copy-muted);
  }

  .mission-client {
    margin-top: 0.5mm !important;
    color: var(--color-copy-muted);
  }

  .mission-description {
    margin-top: 0.5mm;
  }

  .mission-environment {
    margin-top: 0.6mm !important;
    color: var(--color-copy-muted);
  }

  @media (max-width: 600px) {
    .print-document {
      padding: 4mm;
    }

    .employer-banner,
    .mission-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .employer-banner > p:last-child,
    .mission-period {
      width: 100%;
      margin-left: 0 !important;
    }
  }

  @media print {
    :global(html),
    :global(body) {
      color-scheme: only light;
      background: var(--color-page);
    }

    .print-document {
      width: auto;
      min-height: auto;
      margin: 0;
      padding: 0;
      font-family: Arial, 'Liberation Sans', sans-serif;
      font-variant-ligatures: none;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .mission-header code {
      font-family: 'Courier New', 'Liberation Mono', monospace;
    }

    .print-frame {
      box-decoration-break: clone;
    }
  }

  @page {
    size: A4 portrait;
    margin: 8mm;
  }
</style>

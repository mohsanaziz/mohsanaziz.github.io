---
import { requireLocale } from '@/i18n/locales';
import { localeDirection } from '@/i18n/routing';
import '@/styles/main.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
const locale = requireLocale(Astro.currentLocale);
// `dir` is only emitted for right-to-left locales so that the left-to-right pages keep their exact markup.
const direction = localeDirection(locale);
---

<!doctype html>
<html lang={locale} dir={direction === 'rtl' ? direction : undefined} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/NotoSansArabic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-page font-sans text-copy">
    <slot />
  </body>
</html>

---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { GITHUB_LEXICON } from '@/components/lexicon';
import { cv } from '@/data/cv';
import { resolveProfileDetails, urlPathSegments } from '@/data/profile';
import { DEFAULT_LOCALE, localeFormatting, localeOpenGraphCode, LOCALES, requireLocale } from '@/i18n/locales';
import { localeDirection, localeUrlSegment, openGraphImagePath } from '@/i18n/routing';
import '@/styles/main.css';

interface Props {
  title: string;
  description: string;
  kind?: 'public' | 'technical' | 'not-found';
  openGraphImageAlt?: string;
}

const { title, description, kind = 'technical', openGraphImageAlt } = Astro.props;
const locale = requireLocale(Astro.currentLocale);
const { lineHeight } = localeFormatting(locale);
const direction = localeDirection(locale);
const isPublic = kind === 'public';
// Localized LTR pages keep their exact markup; the root 404 names its default direction explicitly.
const renderedDirection = direction === 'rtl' || kind === 'not-found' ? direction : undefined;

const discoveryMetadata = isPublic
  ? (() => {
      const currentPathSegments = Astro.url.pathname.split('/').filter(Boolean);
      const currentLocaleSegment = localeUrlSegment(locale);

      if (currentLocaleSegment !== undefined && currentPathSegments[0] === currentLocaleSegment) {
        currentPathSegments.shift();
      }

      const localeIndependentPath = currentPathSegments.join('/') || undefined;
      const canonicalUrl = getAbsoluteLocaleUrl(locale, localeIndependentPath);
      const alternateUrls = LOCALES.map((alternateLocale) => ({
        locale: alternateLocale,
        href: getAbsoluteLocaleUrl(alternateLocale, localeIndependentPath),
      }));
      // x-default deliberately stays on the site root: it is the sole URL reached without choosing a language (ADR 0007 §7).
      const defaultUrl = getAbsoluteLocaleUrl(DEFAULT_LOCALE);
      const openGraphLocale = localeOpenGraphCode(locale);
      const alternateOpenGraphLocales = LOCALES.filter((alternateLocale) => alternateLocale !== locale).map(localeOpenGraphCode);

      if (!Astro.site || !openGraphImageAlt) {
        throw new Error('Discoverable pages require Astro.site and a localized Open Graph image description.');
      }

      const openGraphImageUrl = new URL(openGraphImagePath(locale), Astro.site).href;

      // Profile fields deliberately use the invariant Latin core name; the localized page name remains in og:title.
      const [profileFirstName, ...profileLastNameParts] = cv.profile.name.trim().split(/\s+/);
      const profileLastName = profileLastNameParts.join(' ');

      if (!profileFirstName || !profileLastName) {
        throw new Error('The profile name must contain a first name and a last name for Open Graph metadata.');
      }

      const { githubProfile } = resolveProfileDetails(cv.profile);
      const githubOwner = urlPathSegments(githubProfile.href).at(0);

      if (!githubOwner) {
        throw new Error('The GitHub profile URL must contain an owner for Open Graph metadata.');
      }

      return {
        canonicalUrl,
        alternateUrls,
        defaultUrl,
        openGraphLocale,
        alternateOpenGraphLocales,
        profileFirstName,
        profileLastName,
        siteName: `${githubOwner}/${GITHUB_LEXICON.repository}`,
        openGraphImageUrl,
        openGraphImageAlt,
      };
    })()
  : undefined;
---

<!doctype html>
<html lang={locale} dir={renderedDirection} class="h-full scroll-smooth" style={`--locale-line-height: ${lineHeight}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {
      discoveryMetadata ? (
        <>
          <link rel="canonical" href={discoveryMetadata.canonicalUrl} />
          {discoveryMetadata.alternateUrls.map(({ locale: alternateLocale, href }) => (
            <link rel="alternate" hreflang={alternateLocale} href={href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={discoveryMetadata.defaultUrl} />

          <meta property="og:url" content={discoveryMetadata.canonicalUrl} />
          <meta property="og:site_name" content={discoveryMetadata.siteName} />
          <meta property="og:type" content="profile" />
          <meta property="profile:first_name" content={discoveryMetadata.profileFirstName} />
          <meta property="profile:last_name" content={discoveryMetadata.profileLastName} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={discoveryMetadata.openGraphImageUrl} />
          <meta property="og:image:alt" content={discoveryMetadata.openGraphImageAlt} />
          <meta property="og:locale" content={discoveryMetadata.openGraphLocale} />
          {discoveryMetadata.alternateOpenGraphLocales.map((alternateLocale) => (
            <meta property="og:locale:alternate" content={alternateLocale} />
          ))}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : kind === 'technical' ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/NotoSansArabic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-page font-sans text-copy">
    <slot />
  </body>
</html>

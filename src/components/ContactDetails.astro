---
import Icon from '@/components/Icon.astro';
import type { ContactDetailView } from '@/i18n/views';

interface Props {
  details: readonly ContactDetailView[];
}

const { details } = Astro.props;
---

<dl class="space-y-4">
  {
    details.map((detail) => (
      <div class="flex min-w-0 gap-3">
        <Icon name={detail.icon} class="mt-0.5 h-4 w-4 shrink-0 text-copy-muted" />
        <div class="min-w-0">
          <dt class="text-xs font-medium tracking-wide text-copy-muted uppercase">{detail.title}</dt>
          <dd class="mt-0.5 text-sm [overflow-wrap:anywhere] text-copy">
            {detail.href ? (
              <a class="rounded-sm text-link" href={detail.href}>
                {detail.info}
              </a>
            ) : (
              detail.info
            )}
          </dd>
        </div>
      </div>
    ))
  }
</dl>

---
interface Props {
  title: string;
  subtitle: string;
  date: string;
}

const { title, subtitle, date } = Astro.props;
---

<div class="relative flex w-full flex-col gap-x-7 gap-y-1 rounded-2xl bg-surface-raised p-5">
  <div class="flex flex-col gap-y-1.5">
    <div class="flex flex-col gap-y-0.5"></div>
    <h1 class="text-lg font-medium">{title}</h1>
    <h2 class="text-muted">{subtitle}</h2>
    <h3 class="text-sm text-accent-strong">{date}</h3>
    <slot />
  </div>
</div>

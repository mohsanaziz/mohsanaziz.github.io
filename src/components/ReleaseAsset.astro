---
import Icon from '@/components/Icon.astro';
import { GITHUB_LEXICON } from '@/components/lexicon';
import StatusBadge from '@/components/StatusBadge.astro';

interface Props {
  version: string;
  href: string;
  fileName: string;
}

const { version, href, fileName } = Astro.props;
---

<div>
  <div class="flex flex-wrap items-center gap-2">
    <StatusBadge label={GITHUB_LEXICON.latest} />
    <span class="text-sm font-semibold text-copy">{version}</span>
  </div>

  <a class="mt-3 flex w-fit min-w-0 items-center gap-2 rounded-sm text-sm text-link" href={href} download={fileName}>
    <Icon name="file" class="h-4 w-4 shrink-0 text-copy-muted" />
    <span class="truncate">{fileName}</span>
  </a>
</div>

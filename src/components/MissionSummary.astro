---
import FactRow from '@/components/FactRow.astro';
import { GITHUB_LEXICON } from '@/components/lexicon';
import { formatMessage } from '@/i18n/messages';
import { useTranslations } from '@/i18n/translate';
import type { MissionSummaryView } from '@/i18n/views';

interface Props {
  mission: string;
  summary: MissionSummaryView;
}

const { mission, summary } = Astro.props;
const { messages } = useTranslations(Astro.currentLocale);
const { labels } = messages;
const facts = [
  [labels.client, summary.client],
  [labels.period, summary.period],
  [labels.duration, summary.duration],
  [labels.status, summary.status],
  [labels.employer, summary.employer],
  [labels.version, summary.version],
] as const;
const stackLabel = formatMessage(messages.accessibility.missionStack, { mission });
---

<div class="overflow-hidden rounded-lg border border-frame-border bg-panel">
  <h4 class="border-b border-rule px-4 py-3 text-sm font-semibold text-copy">{GITHUB_LEXICON.summary}</h4>

  <dl class="divide-y divide-rule px-4 text-sm">
    {facts.map(([label, value]) => <FactRow label={label}>{value}</FactRow>)}
  </dl>

  <div class="border-t border-rule px-4 py-3">
    <h5 class="text-xs font-semibold tracking-wide text-copy-muted uppercase">{GITHUB_LEXICON.stack}</h5>
    <ul class="mt-2 flex flex-wrap gap-1.5" aria-label={stackLabel}>
      {
        summary.technologies.map((technology) => (
          <li class="rounded-full border border-frame-border bg-page px-2 py-1 text-xs leading-none text-copy">{technology}</li>
        ))
      }
    </ul>
  </div>
</div>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { GITHUB_LEXICON } from '@/components/lexicon';

interface Props {
  image: {
    src: ImageMetadata;
    alt: string;
    width: number;
    height: number;
  };
  owner: string;
  repository: string;
  ownerHref: string;
}

const { image, owner, repository, ownerHref } = Astro.props;
---

<header class="border-b border-frame-border bg-panel">
  <div class="mx-auto flex w-full max-w-7xl items-center gap-3 px-4 py-4 sm:px-6 lg:px-8">
    <Image
      src={image.src}
      alt={image.alt}
      class="h-10 w-10 shrink-0 rounded-full object-cover"
      loading="eager"
      width={40}
      height={40}
      densities={[1, 2]}
      decoding="async"
    />

    <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
      <p class="min-w-0 text-lg leading-tight text-copy">
        <a class="rounded-sm font-semibold text-link" href={ownerHref}>{owner}</a>
        <span aria-hidden="true" class="text-copy-muted"> / </span>
        <span class="font-semibold">{repository}</span>
      </p>
      <span class="shrink-0 rounded-full border border-frame-border px-2 py-0.5 text-xs font-medium text-copy-muted"
        >{GITHUB_LEXICON.visibility}</span
      >
    </div>
  </div>
</header>

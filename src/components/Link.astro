---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="no-underline" href={href} target="_blank" rel="noreferrer" aria-label={label}>
  <div class="flex items-center justify-center rounded-lg bg-accent p-2 text-accent-foreground shadow-xs">
    <slot />
  </div>
</a>

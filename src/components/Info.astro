---
interface Props {
  title: string;
  info: string;
}

const { title, info } = Astro.props;
---

<div class="flex flex-row items-center gap-x-2">
  <div class="flex cursor-default items-center justify-center rounded-lg bg-surface-overlay p-2 shadow-sm">
    <slot />
  </div>
  <div class="flex flex-col">
    <span class="text-xs text-accent uppercase">{title}</span>
    <span class="font-bold">{info}</span>
  </div>
</div>

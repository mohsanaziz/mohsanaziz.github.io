---
import FactRow from '@/components/FactRow.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { TONE_BY_CONTRACT } from '@/components/status';
import type { Contract } from '@/data/cv';
import { useTranslations } from '@/i18n/translate';

interface Props {
  company: string;
  role: string;
  contract: Contract;
  period: string;
  duration: string;
  missionCount: number;
}

const { company, role, contract, period, duration, missionCount } = Astro.props;
const translate = useTranslations(Astro.currentLocale);
const { labels } = translate.messages;
const monogram = company
  .split(/\s+/)
  .map((word) => /^(\p{L})/u.exec(word)?.[1])
  .filter((initial): initial is string => initial !== undefined)
  .slice(0, 2)
  .join('')
  .toLocaleUpperCase(translate.locale);
---

<article class="min-w-0 rounded-lg border border-frame-border bg-page p-4 sm:p-5">
  <header class="flex min-w-0 items-center gap-3">
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-frame-border bg-panel text-sm font-bold tracking-wide text-copy"
      aria-hidden="true"
    >
      {monogram}
    </span>
    <div class="min-w-0">
      <h3 class="font-semibold [overflow-wrap:anywhere] text-copy">{company}</h3>
      <p class="mt-0.5 text-sm [overflow-wrap:anywhere] text-copy-muted">{role}</p>
    </div>
  </header>

  <dl class="mt-5 divide-y divide-rule border-t border-rule text-sm">
    <FactRow label={labels.contract}><StatusBadge label={translate.contract(contract)} tone={TONE_BY_CONTRACT[contract]} /></FactRow>
    <FactRow label={labels.period}>{period}</FactRow>
    <FactRow label={labels.duration}>{duration}</FactRow>
    <FactRow label={labels.missions}>{translate.count('mission', missionCount)}</FactRow>
  </dl>
</article>

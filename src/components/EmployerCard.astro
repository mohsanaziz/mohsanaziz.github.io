---
import FactRow from '@/components/FactRow.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { TONE_BY_CONTRACT } from '@/components/status';
import { useTranslations } from '@/i18n/translate';
import type { EmployerView } from '@/i18n/views';

interface Props {
  employer: EmployerView;
  durationInMonths: number;
  missionCount: number;
}

const { employer, durationInMonths, missionCount } = Astro.props;
const translate = useTranslations(Astro.currentLocale);
const { labels } = translate.messages;
const monogram = employer.name
  .split(/\s+/)
  .map((word) => /^(\p{L})/u.exec(word)?.[1])
  .filter((initial): initial is string => initial !== undefined)
  .slice(0, 2)
  .join('')
  .toLocaleUpperCase(translate.locale);
---

<article class="min-w-0 rounded-lg border border-frame-border bg-page p-4 sm:p-5">
  <header class="flex min-w-0 items-center gap-3">
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-frame-border bg-panel text-sm font-bold tracking-wide text-copy"
      aria-hidden="true"
    >
      {monogram}
    </span>
    <div class="min-w-0">
      <h3 class="font-semibold [overflow-wrap:anywhere] text-copy">{employer.name}</h3>
      <p class="mt-0.5 text-sm [overflow-wrap:anywhere] text-copy-muted">{employer.jobTitle}</p>
    </div>
  </header>

  <dl class="mt-5 divide-y divide-rule border-t border-rule text-sm">
    <FactRow label={labels.contract}>
      <StatusBadge label={translate.contract(employer.contract)} tone={TONE_BY_CONTRACT[employer.contract]} />
    </FactRow>
    <FactRow label={labels.period}>{translate.period(employer.period)}</FactRow>
    <FactRow label={labels.duration}>{translate.duration(durationInMonths)}</FactRow>
    <FactRow label={labels.missions}>{translate.count('mission', missionCount)}</FactRow>
  </dl>
</article>

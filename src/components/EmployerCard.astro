---
import StatusBadge from '@/components/StatusBadge.astro';
import type { Contract } from '@/data/cv';

interface Props {
  company: string;
  role: string;
  contract: Contract;
  period: string;
  duration: string;
  missionCount: number;
}

const { company, role, contract, period, duration, missionCount } = Astro.props;
const TONE_BY_CONTRACT: Record<Contract, 'success' | 'cdi'> = {
  Freelance: 'success',
  CDI: 'cdi',
};
const monogram = company
  .split(/\s+/)
  .map((word) => /^(\p{L})/u.exec(word)?.[1])
  .filter((initial): initial is string => initial !== undefined)
  .slice(0, 2)
  .join('')
  .toLocaleUpperCase('fr');
const missionLabel = `${missionCount} ${missionCount === 1 ? 'mission' : 'missions'}`;
---

<article class="min-w-0 rounded-lg border border-frame-border bg-page p-4 sm:p-5">
  <header class="flex min-w-0 items-center gap-3">
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-frame-border bg-panel text-sm font-bold tracking-wide text-copy"
      aria-hidden="true"
    >
      {monogram}
    </span>
    <div class="min-w-0">
      <h3 class="font-semibold [overflow-wrap:anywhere] text-copy">{company}</h3>
      <p class="mt-0.5 text-sm [overflow-wrap:anywhere] text-copy-muted">{role}</p>
    </div>
  </header>

  <dl class="mt-5 divide-y divide-rule border-t border-rule text-sm">
    <div class="grid grid-cols-[5rem_minmax(0,1fr)] items-center gap-3 py-2.5">
      <dt class="text-copy-muted">Contrat</dt>
      <dd class="min-w-0 justify-self-end"><StatusBadge label={contract} tone={TONE_BY_CONTRACT[contract]} /></dd>
    </div>
    <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-3 py-2.5">
      <dt class="text-copy-muted">Période</dt>
      <dd class="min-w-0 text-right font-medium [overflow-wrap:anywhere] text-copy">{period}</dd>
    </div>
    <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-3 py-2.5">
      <dt class="text-copy-muted">Durée</dt>
      <dd class="min-w-0 text-right font-medium text-copy">{duration}</dd>
    </div>
    <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-3 pt-2.5">
      <dt class="text-copy-muted">Missions</dt>
      <dd class="min-w-0 text-right font-medium text-copy">{missionLabel}</dd>
    </div>
  </dl>
</article>

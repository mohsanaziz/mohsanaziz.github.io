---
// PROTOTYPE — jetable. Issue #82. Voir src/prototype-og/README.md.
// Barre flottante de bascule, rendue uniquement en dev : un merge accidentel ne l'expédie pas.
// Volontairement laide — à ne pas confondre avec les cartes jugées au-dessus.
import { CARD_LANGS, cardContent, type CardLang } from '@/prototype-og/content';
import { VARIANT_LIST, harnessHref, type VariantKey } from '@/prototype-og/context';

interface Props {
  variant: VariantKey;
  lang: CardLang;
}

const { variant, lang } = Astro.props;
const currentIndex = VARIANT_LIST.findIndex(({ key }) => key === variant);
const previous = VARIANT_LIST[(currentIndex - 1 + VARIANT_LIST.length) % VARIANT_LIST.length];
const next = VARIANT_LIST[(currentIndex + 1) % VARIANT_LIST.length];
const current = VARIANT_LIST[currentIndex];
---

{
  import.meta.env.DEV && previous && next && current && (
    <div
      dir="ltr"
      lang="fr"
      class="fixed bottom-4 left-1/2 z-50 flex w-[min(52rem,calc(100vw-2rem))] -translate-x-1/2 flex-col gap-2 rounded-2xl border-2 border-fuchsia-500 bg-zinc-950/95 px-3 py-2.5 font-mono text-xs text-zinc-100 shadow-2xl backdrop-blur"
      data-prototype-switcher
    >
      <div class="flex items-center gap-2">
        <a
          class="shrink-0 rounded-lg border border-zinc-700 px-2.5 py-1.5 no-underline hover:bg-zinc-800"
          href={harnessHref(previous.key, lang)}
          aria-label={`Composition précédente : ${previous.name}`}
        >
          ←
        </a>

        <p class="min-w-0 flex-1 text-center leading-snug">
          <span class="font-bold text-fuchsia-400">{current.key}</span>
          <span class="text-zinc-400"> — </span>
          <span class="font-bold">{current.name}</span>
          <span class="ms-2 text-zinc-500">photo : {current.photo}</span>
          <br />
          <span class="text-[0.7rem] text-zinc-400">{current.summary}</span>
        </p>

        <a
          class="shrink-0 rounded-lg border border-zinc-700 px-2.5 py-1.5 no-underline hover:bg-zinc-800"
          href={harnessHref(next.key, lang)}
          aria-label={`Composition suivante : ${next.name}`}
        >
          →
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-1.5 border-t border-zinc-800 pt-2">
        <span class="text-zinc-500">locale</span>
        {CARD_LANGS.map((key) => (
          <a
            class:list={[
              'rounded-lg border px-2 py-1 no-underline',
              key === lang ? 'border-fuchsia-500 bg-fuchsia-500/20 font-bold' : 'border-zinc-700 hover:bg-zinc-800',
            ]}
            href={harnessHref(variant, key)}
          >
            {cardContent(key).label}
          </a>
        ))}
        <span class="ms-2 text-zinc-500">← → composition · ↑ ↓ locale</span>
      </div>
    </div>
  )
}

<script is:inline>
  (() => {
    if (!document.querySelector('[data-prototype-switcher]')) return;

    const variants = ['A', 'B', 'C', 'D'];
    const langs = ['fr', 'en', 'ar', 'ar-sans'];
    const [, , variantParam, langParam] = location.pathname.split('/');
    const variant = Math.max(0, variants.indexOf(variantParam));
    const lang = Math.max(0, langs.indexOf(langParam));

    const go = (nextVariant, nextLang) => {
      const v = variants[(nextVariant + variants.length) % variants.length];
      const l = langs[(nextLang + langs.length) % langs.length];
      location.pathname = `/prototype-og/${v}/${l}/`;
    };

    addEventListener('keydown', (event) => {
      const target = event.target;

      if (target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))) {
        return;
      }

      if (event.key === 'ArrowLeft') go(variant - 1, lang);
      else if (event.key === 'ArrowRight') go(variant + 1, lang);
      else if (event.key === 'ArrowUp') go(variant, lang - 1);
      else if (event.key === 'ArrowDown') go(variant, lang + 1);
    });
  })();
</script>

---
import { STATUS_CLASSES_BY_TONE, type StatusTone } from '@/components/status';

interface Props {
  label: string;
  tone?: StatusTone;
}

const { label, tone = 'success' } = Astro.props;
---

<span class:list={['inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold', STATUS_CLASSES_BY_TONE[tone]]}>
  {label}
</span>

---
interface Props {
  label: string;
  tone?: 'success' | 'cdi';
}

const { label, tone = 'success' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold',
    {
      'border-status-success/45 bg-status-success/14 text-status-success': tone === 'success',
      'border-status-cdi/45 bg-status-cdi/14 text-status-cdi': tone === 'cdi',
    },
  ]}
>
  {label}
</span>

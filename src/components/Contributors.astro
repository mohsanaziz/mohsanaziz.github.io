---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Link from '@/components/Link.astro';

interface ContributorLink {
  href: string;
  label: string;
}

interface Props {
  image: ImageMetadata;
  github: ContributorLink;
  linkedin: ContributorLink;
}

const { image, github, linkedin } = Astro.props;
---

<ul class="space-y-3">
  <li>
    <Link class="flex w-fit items-center gap-3 text-sm font-medium" href={github.href} label={github.label}>
      <Image
        src={image}
        alt=""
        class="h-7 w-7 shrink-0 rounded-full object-cover"
        width={28}
        height={28}
        densities={[1, 2]}
        decoding="async"
      />
      <span>{github.label}</span>
    </Link>
  </li>
  <li>
    <Link class="flex w-fit items-center gap-3 text-sm font-medium" href={linkedin.href} label={linkedin.label}>
      <span
        aria-hidden="true"
        class="flex h-7 w-7 shrink-0 items-center justify-center rounded border border-frame-border bg-panel text-xs font-bold text-copy"
        >in</span
      >
      <span>{linkedin.label}</span>
    </Link>
  </li>
</ul>

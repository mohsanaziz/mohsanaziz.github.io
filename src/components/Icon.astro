---
import { ICONS, type IconDefinition, type IconName } from '@/components/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const icon: IconDefinition = ICONS[name];
---

<svg
  aria-hidden="true"
  width="1em"
  height="1em"
  viewBox={icon.viewBox}
  class={className}
  fill={icon.fill}
  stroke={icon.stroke}
  stroke-linecap={icon.strokeLinecap}
  stroke-linejoin={icon.strokeLinejoin}
  stroke-width={icon.strokeWidth}
  data-icon={name}
>
  {icon.paths.map((path) => <path d={path} />)}
</svg>

---
import type { LanguageShare } from '@/data/languages';

interface Props {
  languages: readonly LanguageShare[];
}

const { languages } = Astro.props;
const accessibleSummary = languages.map(({ name, percentage }) => `${name} ${percentage} %`).join(', ');
---

<div>
  <div class="flex h-2.5 overflow-hidden rounded-full bg-panel" role="img" aria-label={`Répartition des langages : ${accessibleSummary}`}>
    {
      languages.map(({ name, color, percentage }) => (
        <span aria-hidden="true" title={`${name} : ${percentage} %`} style={`width: ${percentage}%; background-color: ${color};`} />
      ))
    }
  </div>

  <ul class="mt-4 space-y-2.5">
    {
      languages.map(({ name, color, percentage }) => (
        <li class="flex items-center gap-2 text-sm">
          <span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background-color: ${color};`} />
          <span class="min-w-0 text-copy">{name}</span>
          <span class="ml-auto text-copy-muted tabular-nums">{percentage} %</span>
        </li>
      ))
    }
  </ul>
</div>
